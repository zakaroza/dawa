# Copy this file to .env and add your own keys. Never commit .env.

# Groq: medical answers, Darija translation and the emergency check
# https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini: reading medicine names from photos
# https://aistudio.google.com
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# VoiceRSS: reading answers aloud
# https://www.voicerss.org
EXPO_PUBLIC_VOICERSS_KEY=your_voicerss_key_here
